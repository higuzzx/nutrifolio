{
  "expo": {
    "name": "Nutrifolio",
    "slug": "nutrifolio",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nutrifolio",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dnatechnology.nutrifolio"
    },
    "android": {
      "package": "com.dnatechnology.nutrifolio",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#080808"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "Permita que o Nutrifolio leia códigos de barras dos alimentos.",
          "recordAudioAndroid": false
        }
      ],
      "expo-notifications"
    ],
    "experiments": { "typedRoutes": true }
  }
}
